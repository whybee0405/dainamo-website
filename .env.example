# Copy to .env and fill in before deploying.

# Long random string. Rotating this signs every existing admin session out.
PAYLOAD_SECRET=

# Local file database for development. Point this at a hosted libSQL/Turso URL
# in production, and set DATABASE_AUTH_TOKEN alongside it.
DATABASE_URI=file:./dainamo.db

# Canonical origin, used for sitemaps, structured data and share cards.
NEXT_PUBLIC_SITE_URL=https://dainamoholdings.co.za
